# macOS
.DS_Store

# Xcode / XcodeGen
ios/Lumisound.xcodeproj/
ios/build/
ios/DerivedData/
ios/ExportOptions.plist
ios/*.xcresult
ios/.xcode.env.local
*.xcuserstate

# Swift / SPM
.build/
*.o
*.d
*.swp
.swiftpm/

# Credentials & secrets
*.ngrok.yml
*.key
*.secret
*.p12
*.mobileprovision
*.keystore
*.jks
api_keys.txt
secrets.txt
local.properties
cookies.txt
ios-bridge/cookies.txt
# Any sibling of a cookie jar — dated backups (cookies.txt.bak-20260913),
# staged candidates, half-written exports. These carry live Google/YouTube
# session cookies exactly like cookies.txt does, but only the two exact
# filenames above were ignored, so a backup taken while swapping jars showed
# up as an untracked file ready to be committed by a `git add -A`.
cookies.txt.*
ios-bridge/cookies.txt.*
# Host-side browser-cookie refresh staging files
.cookies-refresh.*
.env
ios-bridge/.env
# Build-time-injected client secrets (bridge API key) — see
# ios/Config/Secrets.xcconfig.example for setup.
ios/Config/Secrets.xcconfig
# yt-dlp runtime cache, incl. per-user session cookies — never source, never committed
ios-bridge/cache/

# Logs
*.log
tmp/

# Editor
.idea/

# Python
__pycache__/
*.pyc
