<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.lumisound.ios</string>
    </array>
    <!-- SharePlay ("Listen Together" — see ListenTogetherActivity.swift /
         SharePlayCoordinator.swift). Self-serviceable via Xcode's Signing &
         Capabilities "Group Activities" toggle — unlike CarPlay's entitlement
         below (commented out), this one needs no separate Apple approval. -->
    <key>com.apple.developer.group-session</key>
    <true/>
    <!-- HealthKit (see HearingHealthService.swift / AdaptiveSleepTimerService.swift)
         — read-only: headphone audio exposure (Hearing Health feature) and
         sleep analysis (Adaptive Sleep Timer). Self-serviceable, no separate
         Apple approval needed, unlike CarPlay below. -->
    <key>com.apple.developer.healthkit</key>
    <true/>
    <!-- Real APNs push (see AppDelegate.swift / NotificationService.swift /
         ios-bridge's _send_push_best_effort). Self-serviceable — unlike
         CarPlay below, Push Notifications needs no separate Apple approval,
         just an APNs auth key generated at developer.apple.com and the
         server's APNS_KEY_* env vars set. "development" matches AltStore/
         Sideloadly's ad-hoc/development-signed builds, which only Apple's
         sandbox APNs environment will deliver to (server's
         APNS_USE_SANDBOX defaults to "1" to match) — flip both together if
         this ever ships as a true App Store build. -->
    <key>aps-environment</key>
    <string>development</string>
    <!-- CarPlay (see CarPlaySceneDelegate.swift) is intentionally NOT enabled
         here. com.apple.developer.carplay-audio is a restricted entitlement —
         Apple must grant it to this app's paid developer account per
         https://developer.apple.com/contact/carplay/ before Xcode will even
         let this key be added to a provisioning profile; adding it here today
         would just fail codesigning. Once granted, add:
           <key>com.apple.developer.carplay-audio</key>
           <true/>
    -->
</dict>
</plist>
