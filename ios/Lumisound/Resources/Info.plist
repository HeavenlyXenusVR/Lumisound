<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Explicit icon declarations so sideloading services (Signulous, AltStore)
         preserve the app icon after re-signing. Xcode normally injects these from
         xcassets at build time; having them in the source plist is the robust fallback. -->
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIcons</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon60x60</string>
            </array>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
            <key>UIPrerenderedIcon</key>
            <false/>
        </dict>
    </dict>
    <key>CFBundleIcons~ipad</key>
    <dict>
        <key>CFBundlePrimaryIcon</key>
        <dict>
            <key>CFBundleIconFiles</key>
            <array>
                <string>AppIcon76x76</string>
                <string>AppIcon83.5x83.5</string>
            </array>
            <key>CFBundleIconName</key>
            <string>AppIcon</string>
            <key>UIPrerenderedIcon</key>
            <false/>
        </dict>
    </dict>

    <!-- Bundle identity -->
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Lumisound</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>

    <!-- iOS required -->
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Document handling — UIFileSharingEnabled makes the app's Documents
         folder visible in Finder/Files so users can drop audio files there.
         LSSupportsOpeningDocumentsInPlace allows opening files directly. -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>UISupportsDocumentBrowser</key>
    <false/>

    <!-- Supported audio file types for Open-in / Share-sheet import -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Audio File</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>public.audio</string>
                <string>public.mp3</string>
                <string>public.mpeg-4-audio</string>
                <string>com.apple.m4a-audio</string>
                <string>public.aiff-audio</string>
                <string>com.microsoft.waveform-audio</string>
                <string>public.flac-audio</string>
            </array>
        </dict>
    </array>

    <!-- Supported orientations (iPhone) -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Supported orientations (iPad) -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Background audio — REQUIRED for music player to continue in background -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>fetch</string>
        <!-- Lets a "download_ready" content-available push invoke
             AppDelegate's didReceiveRemoteNotification:fetchCompletionHandler:
             to fetch/import a finished background download immediately,
             even while the app is suspended or not running. -->
        <string>remote-notification</string>
    </array>

    <!-- BGTaskScheduler identifier for BackgroundRefreshService's periodic
         subscriptions/tracked-playlists check — must match the identifier
         string passed to BGTaskScheduler.register/submit exactly. -->
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.lumisound.ios.refresh</string>
        <string>com.lumisound.ios.trackvault</string>
        <!-- Long-form download catch-up. Separate from .refresh (a
             BGAppRefreshTask, ~30s) because resuming a several-hundred-track
             playlist cannot fit in that budget — see
             BackgroundRefreshService.downloadTaskIdentifier. -->
        <string>com.lumisound.ios.downloads</string>
    </array>

    <!-- Live Activities — Lock Screen / Dynamic Island Now Playing -->
    <key>NSSupportsLiveActivities</key>
    <true/>

    <!-- Privacy usage descriptions -->
    <key>NSAppleMusicUsageDescription</key>
    <string>Lumisound reads your music library to display and play your songs.</string>
    <!-- Required by CMHeadphoneMotionManager (Spatial Audio's head tracking) —
         calling its APIs without this key present crashes the app. -->
    <key>NSMotionUsageDescription</key>
    <string>Lumisound uses head tracking to anchor Spatial Audio in place as you turn your head, and step counting (Workout Mode) to match playback speed to your pace.</string>
    <!-- Required to call LAContext.evaluatePolicy with Face ID (Settings →
         General → App Lock) — omitting this crashes the app on first use on
         a Face ID device, even though Touch ID/passcode need no such key. -->
    <key>NSFaceIDUsageDescription</key>
    <string>Lumisound can use Face ID to lock the app, since it syncs your playlists and listening history to your account.</string>
    <!-- Required by AVAudioRecorder (Hum to Search) — omitting this crashes
         the app the first time recording is attempted. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Lumisound records a short hum to find a matching song already in your library.</string>

    <!-- Status bar -->
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>

    <!-- Scene manifest (no multi-window on the phone side; CarPlay gets its
         own scene role — see CarPlaySceneDelegate.swift). The CarPlay
         configuration is inert without the com.apple.developer.carplay-audio
         entitlement (see Lumisound.entitlements' comment) — a head unit
         simply won't connect to it until that's granted and added. -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
        <key>UISceneConfigurations</key>
        <dict>
            <key>CPTemplateApplicationSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneClassName</key>
                    <string>CPTemplateApplicationScene</string>
                    <key>UISceneConfigurationName</key>
                    <string>CarPlay Configuration</string>
                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
                </dict>
            </array>
        </dict>
    </dict>

    <!-- Launch screen (storyboard-free) -->
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Bearer key for the official bridge's check_auth()-gated legacy routes
         — build-time-injected, see ../../Config/Base.xcconfig. Read via
         Bundle.main in StreamingService.swift. -->
    <key>LumisoundBridgeAPIKey</key>
    <string>$(LUMISOUND_BRIDGE_API_KEY)</string>

    <!-- Custom URL scheme — currently only used as the OAuth2 redirect target
         for Discord account verification (see DiscordVerificationService.swift
         / LumisoundApp.swift's .onOpenURL). The bridge's
         /api/discord/oauth/callback redirects the ASWebAuthenticationSession
         here (lumisound://discord-verify?success=...) once Discord's own
         consent flow finishes, handing control straight back to the app. */*
         is not registered as an alternate document opener — this scheme is
         verification-only, unlike the Files-app "Open in Lumisound" audio
         import path above, which goes through CFBundleDocumentTypes instead. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>lumisound</string>
            </array>
        </dict>
    </array>

</dict>
</plist>
